@page "/todos"
@using BlazingSingularity.Demo.Client.Todo.Dtos
@using BlazingSingularity.Commands
@using BlazingSingularity.Signals
@using BlazingSingularity.Endpoints

@rendermode @(new InteractiveWebAssemblyRenderMode(false))

@* Search bar *@
<div class="mb-3">
    <input type="text" class="form-control" placeholder="Search todos... (updates on change)"
           @bind="SearchText" @bind:event="oninput" />
</div>

@* Foreach todo list *@

@if(LoadTodoListAsyncCommand.IsLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    @foreach (var todo in todos)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h5 class="card-title">
                    @todo.Title
                </h5>
                <p class="card-text">
                    <small class="text-muted">Completed: @todo.IsCompleted</small>
                </p>
            </div>
        </div>
    }
}

@code {
    private List<TodoForListDto> todos = [];

    [Signal]
    private string? _searchText;

    protected override async Task OnInitializedAsync()
    {
        SearchTextSignal.OnChange(async _ =>
        {
            await LoadTodoListAsyncCommand.ExecuteAsync();
            await InvokeAsync(StateHasChanged);
        });
        await LoadTodoListAsyncCommand.ExecuteAsync();
    }

    [RelayCommand]
    public async Task LoadTodoListAsync()
    {
        // Use the generated endpoint proxy instead of manually injected HttpClient
        todos = await GetTodosEndpoint.Http(SearchText);
    }

    /// <summary>
    /// Endpoint for fetching todos with optional search filter.
    /// The generator creates GetTodosEndpoint.Http() proxy method.
    /// </summary>
    [Endpoint(HttpVerb.Get, "/api/todos")]
    public Task<List<TodoForListDto>> GetTodos(string? search)
    {
        // This body would be used on the server side
        throw new NotImplementedException("Server-side implementation");
    }
}

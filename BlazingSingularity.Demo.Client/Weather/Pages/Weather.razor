@page "/weather"
@using BlazingSingularity.Commands
@using BlazingSingularity.Demo.Client.Weather.Dtos

@rendermode @(new InteractiveWebAssemblyRenderMode(false))

<PageTitle>Weather</PageTitle>

<h1 class="mb-4">Weather Forecasts</h1>

<!-- Load Weather Section -->
<div class="card mb-4 shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-1">Load Forecasts</h5>
            <p class="text-muted mb-0">Click the button to fetch the latest weather data. (Cancellable)</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary"
                    @onclick="@(() => LoadForecastsAsyncCommand.ExecuteAsync())"
                    disabled="@LoadForecastsAsyncCommand.IsLoading">
                Load Weather
            </button>
            @if (LoadForecastsAsyncCommand.IsLoading && LoadForecastsAsyncCommand.IsCancellable)
            {
                <button class="btn btn-danger"
                        @onclick="@(() => LoadForecastsAsyncCommand.CancelCommand())">
                    Cancel
                </button>
            }
        </div>
    </div>

    @if (LoadForecastsAsyncCommand.IsLoading)
    {
        <div class="p-3 border-top d-flex align-items-center gap-2">
            <div class="spinner-border text-primary" style="width: 1.5rem; height: 1.5rem;"></div>
            <span class="text-muted">Loading forecasts...</span>
        </div>
    }
</div>

<!-- Search Section with Multiple Filters -->
@if (!LoadForecastsAsyncCommand.IsLoading && forecasts.Length > 0)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Filter Forecasts</h5>
            <p class="text-muted small mb-3">Demonstrates <strong>BoundAsyncRelayCommand</strong> - multiple filter properties captured at execution time</p>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Summary</label>
                    <input type="text"
                           class="form-control"
                           placeholder="e.g., 'Hot', 'Cold', 'Warm'"
                           @bind="summaryFilter"
                           @bind:after="OnFilterChanged"
                           disabled="@SearchCommand.IsLoading" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Min Temperature (°C)</label>
                    <input type="number"
                           class="form-control"
                           placeholder="e.g., -10"
                           @bind="minTemp"
                           @bind:after="OnFilterChanged"
                           disabled="@SearchCommand.IsLoading" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max Temperature (°C)</label>
                    <input type="number"
                           class="form-control"
                           placeholder="e.g., 30"
                           @bind="maxTemp"
                           @bind:after="OnFilterChanged"
                           disabled="@SearchCommand.IsLoading" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-secondary w-100"
                            @onclick="ClearFilters"
                            disabled="@SearchCommand.IsLoading">
                        Clear
                    </button>
                </div>
            </div>

            <div class="row g-2 mt-2">
                <div class="col-auto">
                    <button class="btn btn-primary"
                            @onclick="@(() => SearchCommand.ExecuteAsync(null))"
                            disabled="@(!SearchCommand.CanExecute(null))">
                        @if (SearchCommand.IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <span>Apply Filters</span>
                        }
                    </button>
                    @if (SearchCommand.IsLoading && SearchCommand.IsCancellable)
                    {
                        <button class="btn btn-danger ms-2"
                                @onclick="@(() => SearchCommand.CancelCommand())">
                            Cancel
                        </button>
                    }
                </div>
                <div class="col-auto">
                    @if (!string.IsNullOrWhiteSpace(summaryFilter) || minTemp.HasValue || maxTemp.HasValue)
                    {
                        <span class="badge bg-info text-dark align-self-center">
                            Active filters:
                            @if (!string.IsNullOrWhiteSpace(summaryFilter)) { <span>Summary</span> }
                            @if (minTemp.HasValue) { <span>Min Temp</span> }
                            @if (maxTemp.HasValue) { <span>Max Temp</span> }
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Forecast Table Section -->
@if (!LoadForecastsAsyncCommand.IsLoading)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Forecast Results</strong>
            @if (filteredForecasts.Length > 0)
            {
                <span class="badge bg-secondary">@filteredForecasts.Length result(s)</span>
            }
        </div>

        <div class="card-body p-0">
            @if (filteredForecasts.Length == 0)
            {
                <div class="p-4 text-center text-muted">
                    <p class="mb-0">No forecasts found matching your search.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Temp (°C)</th>
                                <th>Temp (°F)</th>
                                <th>Summary</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var forecast in filteredForecasts)
                            {
                                <tr>
                                    <td>@forecast.Date.ToShortDateString()</td>
                                    <td><span class="badge bg-primary">@forecast.TemperatureC °C</span></td>
                                    <td><span class="badge bg-info text-dark">@forecast.TemperatureF °F</span></td>
                                    <td>@forecast.Summary</td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="@(() => ViewForecastDetailCommand.ExecuteAsync(forecast.Id))">
                                            View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<!-- Detail Panel -->
@if (ViewForecastDetailCommand.IsLoading)
{
    <div class="card shadow-sm">
        <div class="card-body d-flex align-items-center gap-2">
            <div class="spinner-border text-primary"></div>
            <span class="text-muted">Loading detail...</span>
        </div>
    </div>
}
else if (selectedForecastDetail is not null)
{
    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Weather Detail</strong>
        </div>
        <div class="card-body">
            <h5 class="mb-3">Forecast for @selectedForecastDetail.Date.ToShortDateString()</h5>

            <p><strong>Temperature:</strong> @selectedForecastDetail.TemperatureC °C (@selectedForecastDetail.TemperatureF °F)</p>
            <p><strong>Summary:</strong> @selectedForecastDetail.Summary</p>

            <button class="btn btn-secondary"
                    @onclick="() => CloseForecastDetail()">
                Close
            </button>
        </div>
    </div>
}
